# ==============================================================================
# RISPFID FISH - Client Environment Variables
# ==============================================================================
# Isi nilai berikut dengan kredensial project Supabase Anda.
# Dapatkan dari Supabase Dashboard -> Project Settings -> API.
# CATATAN KEAMANAN: HANYA gunakan Anon / Public Key di sini. JANGAN pernah
# memasukkan Service Role Secret Key ke dalam file frontend!
#
# Jika nilai ini dikosongkan, RISPFID FISH otomatis berjalan dalam
# "Mode Tamu / Offline Dev" dengan penyimpanan aman di LocalStorage yang
# sepenuhnya meniru aturan transaksi database Supabase.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
